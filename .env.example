# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL
# If DATABASE_URL is set, it takes precedence over the individual DB_* values.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=ratsystem
DB_SSLMODE=disable

# File storage. Relative paths are resolved from the process working directory.
UPLOAD_DIR=uploads

# Delete audit logs older than this many days at startup and every 24 hours.
# Valid range: 1-3650. Default: 90.
LOG_RETENTION_DAYS=90
